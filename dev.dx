::heading level=2 id=gates
The gates dx runs itself
::end

::paragraph id=gates-note
Each gate runs inside the same kernel sandbox every document gets: reads scoped to this repository, no network, writes only where the block's `writes=` grant says. The cargo gates find the rustup toolchain themselves — the sandbox redirects `$HOME`, so `CARGO_HOME` has to be stated, not assumed.
::end

::code id=engine lang=bash run reads=rust writes=rust/target timeout=900
CARGO_BIN="$(type -ap cargo 2>/dev/null | grep "/\.cargo/bin/cargo" | head -1)"
[ -n "$CARGO_BIN" ] || { echo "rustup cargo not found on PATH"; exit 1; }
export CARGO_HOME="${CARGO_BIN%/bin/cargo}"
export RUSTUP_HOME="${CARGO_HOME%/.cargo}/.rustup"
export PATH="${CARGO_BIN%/cargo}:$PATH"
cd rust
fail=0
for crate in doc-core doc-store; do
  log="$DX_SANDBOX/$crate.log"
  if cargo test -p "$crate" --offline --locked >"$log" 2>&1; then
    grep "^test result" "$log" | awk -F'[ ;]+' -v c="$crate" '{p+=$4} END {print c": "p" passed"}'
  else
    fail=1; echo "$crate: FAILED"; tail -5 "$log"
  fi
done
[ "$fail" = 0 ] && echo "ok - engine crates green inside the sandbox (doc-wasm is held by the JS parity suites below)" || exit 1
::end

