::code id=page-contract lang=bash run reads=rust,examples timeout=120
fail=0
out="$DX_SANDBOX/render"
mkdir -p "$out"
dx render examples/showcase.dx --out "$out/showcase.html" >/dev/null 2>&1 || { echo "render failed: showcase"; exit 1; }
dx render examples/GETTING_STARTED.dx --out "$out/guide.html" >/dev/null 2>&1 || { echo "render failed: guide"; exit 1; }
grep -q "<details" "$out/showcase.html" && echo "fold: details/summary, CSS-only" || { echo "fold missing"; fail=1; }
if grep -q "<script" "$out/showcase.html" "$out/guide.html"; then echo "a script reached the page"; fail=1; else echo "scripts: none on any page"; fi
if grep -Eq "(src|href)=\"https?://" "$out/showcase.html"; then echo "an external fetch reached the page"; fail=1; else echo "external fetches: none"; fi
grep -q "sandbox=\"\"" "$out/guide.html" && echo "view frame: sandbox stays empty" || { echo "view frame sandbox not empty"; fail=1; }
[ "$fail" = 0 ] && echo "ok - the rendered page holds its contract" || exit 1
::end

