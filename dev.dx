::code id=surfaces lang=bash run reads=editor timeout=300
fail=0
for suite in github vscode; do
  log="$DX_SANDBOX/$suite.log"
  if node --test editor/$suite/test/*.test.mjs >"$log" 2>&1; then
    n="$(grep -E "pass [0-9]+" "$log" | head -1 | awk '{print $NF}')"
    echo "$suite: $n passed"
  else
    fail=1; echo "$suite: FAILED"; tail -5 "$log"
  fi
done
[ "$fail" = 0 ] && echo "ok - both JS surfaces green, engine parity held" || exit 1
::end

