::paragraph id=coverage-self-check-lead
A coverage floor in this repository's own pipeline would be a product decision about this project's own tolerance, which `docs/search-coverage.dx#gateable-body` deliberately does not presume on a project's behalf. What this harness proves instead is the mechanism itself, end to end, against a scratch workspace: a document hit, a source-file fallback, and a hit on nothing are each recorded correctly to `.doc/coverage.jsonl`; `dx coverage` reports the rate and the fallback queries, most-repeated first, never the document hit among them; `--min-rate` passes below the observed rate and fails above it; a workspace never searched at all reports "no data" and never fails a floor it has no evidence for; and the log actually prunes itself once real searches carry it past its bound.
::end

::code id=coverage-self-check lang=bash run reads=rust writes=rust/target timeout=600
CARGO_BIN="$(type -ap cargo 2>/dev/null | grep "/\.cargo/bin/cargo" | head -1)"
[ -n "$CARGO_BIN" ] || { echo "rustup cargo not found on PATH"; exit 1; }
export CARGO_HOME="${CARGO_BIN%/bin/cargo}"
export RUSTUP_HOME="${CARGO_HOME%/.cargo}/.rustup"
export PATH="${CARGO_BIN%/cargo}:$PATH"
fail=0

(cd rust && cargo build --offline --locked --quiet -p doc-cli) || { echo "build failed"; exit 1; }
dx_bin="$PWD/rust/target/debug/dx"
[ -x "$dx_bin" ] || { echo "no dx binary at $dx_bin"; exit 1; }

ws="$DX_SANDBOX/coverage-ws"
rm -rf "$ws"
mkdir -p "$ws"

# A document a search can land on, and a source file a search can only fall back to.
"$dx_bin" new "$ws/guide.dx" --title "Coverage fixture" >/dev/null
"$dx_bin" set "$ws/guide.dx" intro --text "A kumquat grove borders the west field." >/dev/null
printf 'The driftwood tally sits beside the pier.\n' > "$ws/notes.rs"

"$dx_bin" search kumquat "$ws" >/dev/null       # 1. lands on the document
"$dx_bin" search driftwood "$ws" >/dev/null     # 2. falls back to the source file
"$dx_bin" search zzquorxblat "$ws" >/dev/null   # 3. lands on nothing

log="$ws/.doc/coverage.jsonl"
[ -f "$log" ] || { echo "FAIL no coverage.jsonl after three searches"; fail=1; }
recorded=$(wc -l < "$log" | tr -d ' ')
[ "$recorded" = 3 ] || { echo "FAIL expected 3 recorded searches, found $recorded"; fail=1; }

line_for() { grep "\"query\":\"$1\"" "$log"; }
line_for kumquat     | grep -q '"landed":"document"' || { echo "FAIL document hit not recorded as document"; fail=1; }
line_for driftwood   | grep -q '"landed":"source"'   || { echo "FAIL source hit not recorded as source"; fail=1; }
line_for zzquorxblat | grep -q '"landed":"none"'     || { echo "FAIL empty hit not recorded as none"; fail=1; }

# `dx coverage` reports the rate and lists exactly the two fallbacks, never the document hit.
report=$("$dx_bin" coverage "$ws")
echo "$report" | grep -q "1/3"         || { echo "FAIL coverage report did not show 1/3"; fail=1; }
echo "$report" | grep -q "driftwood"   || { echo "FAIL coverage report dropped the driftwood fallback"; fail=1; }
echo "$report" | grep -q "zzquorxblat" || { echo "FAIL coverage report dropped the zzquorxblat fallback"; fail=1; }
echo "$report" | grep -q "kumquat"     && { echo "FAIL coverage report listed a document hit as a fallback"; fail=1; }

# `--min-rate` is a normal gate: it passes below the observed rate and fails above it.
"$dx_bin" coverage "$ws" --min-rate 0.1 >/dev/null || { echo "FAIL --min-rate 0.1 should pass at a 1/3 rate"; fail=1; }
"$dx_bin" coverage "$ws" --min-rate 0.9 >/dev/null 2>&1 && { echo "FAIL --min-rate 0.9 should fail at a 1/3 rate"; fail=1; }

# A workspace that has never been searched reports "no data" and never fails a floor.
fresh="$DX_SANDBOX/coverage-fresh"
rm -rf "$fresh"
mkdir -p "$fresh"
"$dx_bin" new "$fresh/seed.dx" >/dev/null
"$dx_bin" coverage "$fresh" --min-rate 0.99 >/dev/null || { echo "FAIL a workspace with no data failed a floor"; fail=1; }

# Pruning: seed the log past its bound directly (no need to spend 2000+ real searches on
# it), then one more real search must trip the same prune a real workload would.
before=2500
: > "$log"
for i in $(seq 1 "$before"); do
  printf '{"query":"synthetic-%s","landed":"source","path":"seed.rs"}\n' "$i"
done >> "$log"
"$dx_bin" search kumquat "$ws" >/dev/null
after=$(wc -l < "$log" | tr -d ' ')
[ "$after" -gt 0 ] || { echo "FAIL log emptied instead of pruning"; fail=1; }
[ "$after" -lt $((before / 2)) ] || { echo "FAIL log did not shrink after crossing its bound: $after of $before lines"; fail=1; }

[ "$fail" = 0 ] && echo "ok - coverage records, reports, gates on --min-rate, and prunes itself, all end to end" || exit 1
::end

