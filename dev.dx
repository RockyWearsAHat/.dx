::code id=corpus lang=bash run reads=examples,index.dx timeout=120
fail=0; count=0
for f in $(dx ls . 2>/dev/null | awk '{print $1}'); do
  [ "$f" = "dev.dx" ] && continue   # this very run is writing it
  count=$((count + 1))
  dx text "$f" >/dev/null 2>&1 || { echo "does not resolve: $f"; fail=1; }
  dx fmt "$f" --check >/dev/null 2>&1 || { echo "not canonical: $f"; fail=1; }
done
[ "$count" -ge 10 ] || { echo "only $count documents listed — the corpus is ~a dozen, so an empty ls is a broken resolver, not a clean pass"; fail=1; }
[ "$fail" = 0 ] && echo "ok - $count documents resolve and are canonical" || exit 1
::end

