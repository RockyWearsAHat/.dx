::code id=lints lang=bash run reads=rust writes=rust/target timeout=900
CARGO_BIN="$(type -ap cargo 2>/dev/null | grep "/\.cargo/bin/cargo" | head -1)"
[ -n "$CARGO_BIN" ] || { echo "rustup cargo not found on PATH"; exit 1; }
export CARGO_HOME="${CARGO_BIN%/bin/cargo}"
export RUSTUP_HOME="${CARGO_HOME%/.cargo}/.rustup"
export PATH="${CARGO_BIN%/cargo}:$PATH"
cd rust
fail=0
cargo fmt --check >/dev/null 2>&1 && echo "fmt: one shape" || { echo "fmt: drift"; fail=1; }
log="$DX_SANDBOX/clippy.log"
if cargo clippy --all-targets --offline --locked -- -D warnings >"$log" 2>&1; then
  echo "clippy: no warning survives"
else
  fail=1; echo "clippy: FAILED"; tail -5 "$log"
fi
[ "$fail" = 0 ] && echo "ok - the tree lints clean" || exit 1
::end

