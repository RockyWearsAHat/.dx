# Local workspace noise
.DS_Store

# Claude Code session state: personal overrides, workflow worktrees, task locks.
.claude/

# Git-ignored scratch documents
/.doc/local.dxcp

# The local index: SQLite plus its journal files, rebuildable from the packs
/.doc/index.db
/.doc/index.db-*

# Rust build output
rust/target/

# Release build output (packaging/build-*.sh)
packaging/build/

# VS Code extension build output (wasm from rust/doc-wasm, editor from editor/surface).
# editor/vscode/surface/ is a copy: `editor/surface` is the one source, and a second
# committed copy is the drift this whole arrangement exists to prevent.
editor/vscode/dist/
editor/vscode/wasm/
editor/vscode/surface/
editor/vscode/node_modules/
*.vsix

# Browser extension test fixture: generated by editor/github/test/fixture.sh from a real
# `dx sync`. The engine in editor/github/wasm/ is deliberately NOT ignored — it is what
# `packaging/` builds every shipped extension out of, so it has to be committed. Refresh both
# builds with editor/build.sh; a stale one fails the node suite.
editor/github/test/fixture/

# Agent tooling state — generated beside the project, never part of it. Each of these was
# once committed; together they were 101 files and 2.0 MB of stale generated index, vendored
# third-party skills, and session logs, none of it referenced by a single line of the project.
/.gsh/
/.helpers/
/.github/knowledge/
/.github/session-memory/
/.github/matt-pocock-skills/
/.github/devops-audit-community-settings.json

# wasm-pack type declarations: nothing consumes them (the extension is plain JS)
editor/github/wasm/*.d.ts
