#!/usr/bin/env bash
# Wrapper for node that uses custom test reporter by default
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Find the real node binary by getting the latest NVM version, then fall back to system
REAL_NODE=""
if [[ -d ~/.nvm/versions/node ]]; then
  # Get latest v* directory
  for nvm_dir in $(ls -1d ~/.nvm/versions/node/v* 2>/dev/null | sort -V | tail -1); do
    if [[ -x "$nvm_dir/bin/node" ]]; then
      REAL_NODE="$nvm_dir/bin/node"
      break
    fi
  done
fi

# Fallback to system node
if [[ -z "$REAL_NODE" ]]; then
  REAL_NODE="/usr/bin/node"
fi

if [[ ! -x "$REAL_NODE" ]]; then
  echo "Could not find node binary at $REAL_NODE" >&2
  exit 1
fi

if [[ "$1" == "--test" ]]; then
  exec "$REAL_NODE" --test-reporter="$(cd "$SCRIPT_DIR/.." && pwd)/editor/test-reporter.mjs" "$@"
else
  exec "$REAL_NODE" "$@"
fi
