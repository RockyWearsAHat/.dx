{
  "manifest_version": 3,
  "name": "dx documents for GitHub",
  "version": "1.0.0",
  "description": "Shows .dx documents on github.com as documents: resolves each pointer against the repository's committed pack and renders the real page, in file views and in diffs.",
  "background": {
    "service_worker": "engine.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["resolve.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/dx-16.png",
    "32": "icons/dx-32.png",
    "48": "icons/dx-48.png",
    "128": "icons/dx-128.png"
  },
  "permissions": [],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
