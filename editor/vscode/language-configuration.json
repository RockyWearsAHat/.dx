{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["`", "`"],
    ["*", "*"]
  ],
  "folding": {
    "markers": {
      "start": "^::(?!end)[a-z-]+",
      "end": "^::end\\s*$"
    }
  }
}
